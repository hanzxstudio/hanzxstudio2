# GROQ_API_KEY: RECOMMENDED (free, no credit card) — transcription (Whisper)
# + clip finding + summaries, ~8 hours of audio/day free.
# Get one at https://console.groq.com -> API Keys -> Create API Key (key starts
# with gsk_). Put it in .env.local (same folder), or paste it in the app:
# Auto Clips > Add API Key > Groq (Free). The server uses Groq automatically
# when this key is set.
GROQ_API_KEY=""

# GEMINI_API_KEY: Optional fallback for Gemini AI (transcription, auto-clips,
# captions). Put your real key in .env.local — the server loads .env.local
# first, then .env. Never commit .env or .env.local, and never send them to
# a client. You can also paste/change the key from inside the app:
# Auto Clips > API Key > Gemini.
# NOTE: Google has restricted the Gemini free tier on many projects
# ("free tier is not available for this project", HTTP 403). If you see that
# error, use Groq Free instead — no billing needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TRANSCRIPTION_PROVIDER: auto (default) | groq | gemini
# auto = use Groq whenever GROQ_API_KEY is set, otherwise Gemini.
# Set to "gemini" only if you want to force Gemini even with a Groq key.
TRANSCRIPTION_PROVIDER="auto"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
